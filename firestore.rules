rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // a real account (email/password or Google), not the anonymous one every visitor gets
    function permanent() { return signedIn() && request.auth.token.get('email', '') != ''; }

    // One document per room. Anyone signed in (anonymously) can watch a room.
    // Its two seated players can change the game; everyone else can only claim the empty seat B,
    // or take the short lease that guards that claim. Nobody can move or remove a seated player.
    // Every write stamps `exp` (milliseconds) three days ahead; it can't be pushed further out,
    // and once it passes anyone may delete the room.
    match /rooms/{code} {
      function me() { return request.auth.uid; }
      function seats() { return resource.data.seats; }
      function seated() { return seats()['0'] == me() || ('1' in seats() && seats()['1'] == me()); }
      function mySeat() { return seats()['0'] == me() ? '0' : '1'; }
      function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
      // the only fields the game writes, and a cap on the game state so a room can't be blown up
      function shapeOK(d) {
        return d.keys().hasOnly(['v', 'seats', 'setup', 'cfg', 'picks', 'dec', 'state', 'rev', 'deck0',
                                 'created', 'exp', 'expireAt', 'lease', 'rep', 'emo'])
          && (!('state' in d) || (d.state is string && d.state.size() < 200000))
          && d.exp is number && d.exp <= request.time.toMillis() + 4 * 86400000;
      }
      // a player writes only their own entry in `setup` (name, heartbeat, "left") ...
      function ownSetup() {
        return !('setup' in changed())
          || request.resource.data.setup.diff(resource.data.get('setup', {})).affectedKeys().hasOnly([mySeat()]);
      }
      // ... and their own reaction (emoji or quick phrase)
      function ownEmo() {
        return !('emo' in changed())
          || request.resource.data.emo.diff(resource.data.get('emo', {})).affectedKeys().hasOnly([mySeat()]);
      }
      // ... and reports a ranked result once, for their own seat only
      function ownReport() {
        return !('rep' in changed())
          || (request.resource.data.rep.diff(resource.data.get('rep', {})).affectedKeys().hasOnly([mySeat()])
              && !(mySeat() in resource.data.get('rep', {})));
      }

      allow read: if signedIn();

      allow create: if signedIn()
        && code.matches('^[A-Z0-9]{4}$')
        && request.resource.data.seats.keys().hasOnly(['0'])
        && request.resource.data.seats['0'] == me()
        && shapeOK(request.resource.data);

      allow update: if signedIn() && shapeOK(request.resource.data) && (
        // a seated player: anything in the game, but the seats stay as they are
        (seated() && request.resource.data.seats == seats() && ownSetup() && ownReport() && ownEmo())
        // anyone else: sit down in the empty seat B, and change nothing but that and the timestamps
        || (!('1' in seats()) && seats()['0'] != me()
            && changed().hasOnly(['seats', 'exp', 'expireAt', 'lease'])
            && request.resource.data.seats.diff(seats()).affectedKeys().hasOnly(['1'])
            && request.resource.data.seats['1'] == me())
        // anyone else: take the five-second lease that makes two people claiming seat B take turns
        || (!('1' in seats())
            && changed().hasOnly(['lease'])
            && request.resource.data.lease.holder == me())
      );

      allow delete: if signedIn() && resource.data.exp < request.time.toMillis();
    }

    // Play statistics: stats/all and one document per day (dYYYYMMDD). Anyone may read them; a write may
    // only add one to counters, so the numbers can't be reset or inflated in one go.
    match /stats/{id} {
      function sk() { return ['players', 'active', 'visits', 'drafts', 'games', 'solo', 'local', 'online', 'ranked', 'rankedAI']; }
      function plusOne(k) {
        return !(k in request.resource.data) || request.resource.data[k] == (resource == null ? 0 : resource.data.get(k, 0)) + 1
          || (resource != null && request.resource.data[k] == resource.data.get(k, 0));
      }
      function countersOK() {
        return request.resource.data.keys().hasOnly(sk())
          && plusOne('players') && plusOne('active') && plusOne('visits') && plusOne('drafts') && plusOne('games') && plusOne('solo')
          && plusOne('local') && plusOne('online') && plusOne('ranked') && plusOne('rankedAI');
      }
      allow read: if true;
      allow create, update: if signedIn() && id.matches('^(all|d[0-9]{8})$') && countersOK();
    }

    // Feedback from players: anyone signed in may add a note; nobody can read, change or delete it from
    // the page (the owner reads them in the Firebase console).
    match /feedback/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['text', 'stars', 'tags', 'contact', 'page', 'league', 'lang', 'ver', 'created', 'uid', 'name', 'ua'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 1000
        && request.resource.data.contact is string && request.resource.data.contact.size() <= 100
        && request.resource.data.stars is int && request.resource.data.stars >= 0 && request.resource.data.stars <= 5
        && request.resource.data.tags is list && request.resource.data.tags.size() <= 5
        && request.resource.data.page in ['home', 'result']
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.get('ua', '').size() <= 200 && request.resource.data.get('name', '').size() <= 20;
      allow read, update, delete: if false;
    }

    // a player's last five matches (shown on the home page): one small document, only its owner reads or writes it
    match /players/{uid}/hist/{doc} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid && doc == 'recent'
        && request.resource.data.keys().hasOnly(['list', 'at'])
        && request.resource.data.list is list && request.resource.data.list.size() <= 5
        && request.resource.data.at is number;
    }

    // One record per account for ranked play. Only its owner writes it, and only in these steps:
    // pick or change a nickname; start a ranked game (book the loss: K x expected score, Elo);
    // a confirmed win (add K back); or drop a pending game (the booked loss stays).
    // Elo with K = 100 on a 1250 scale (an even game is worth 50); a win streak against people adds
    // 10 / 20 / 30 from the 2nd win in a row. Ranked games against the computer can't be checked here,
    // so they are worth half (-25 booked, +50 for a win), five a day, below 2100 (the major-league
    // tier), and leave the streak alone.
    // A loss costs 3/4 of the Elo amount (an even game: -38) and never takes a rating below 1000; the booked
    // loss is pendD and the win on top of it is pendW, so a win adds pendD + pendW back.
    match /players/{uid} {
      function nd() { return request.resource.data; }
      function od() { return resource.data; }
      function pchanged() { return nd().diff(od()).affectedKeys(); }
      function shape() {
        return nd().keys().hasOnly(['name', 'rating', 'games', 'wins', 'losses', 'pend', 'pendAt', 'pendD', 'created', 'aiDay', 'aiN', 'streak', 'season', 'hist', 'pendW'])
          && nd().name is string && nd().name.size() >= 2 && nd().name.size() <= 16
          && nd().rating is int && nd().games is int && nd().wins is int && nd().losses is int
          && nd().pend is string && nd().pendAt is int && nd().pendD is int
          && nd().get('aiDay', 0) is int && nd().get('aiN', 0) is int && nd().get('streak', 0) is int
          && nd().get('season', 1) is int && nd().get('hist', {}) is map && nd().get('pendW', 0) is int;
      }
      function room(c) { return get(/databases/$(database)/documents/rooms/$(c)).data; }
      function seatOf(r) { return r.seats['0'] == uid ? '0' : '1'; }
      function other(s) { return s == '0' ? '1' : '0'; }
      function inRoom(r) { return r.seats['0'] == uid || r.seats.get('1', '') == uid; }
      // the opponent's rating before this game (their record may already have booked its loss)
      function preRating(p, r) { return p.pend == nd().pend && p.pendAt == r.created ? p.rating + p.pendD : p.rating; }
      function lossFor(mine, theirs) { return math.round(100.0 / (1.0 + math.pow(10.0, (theirs - mine) / 1250.0))); }
      // what a loss may book: d, but never below 1000
      function floored(r, d) { return r - 1000 <= 0 ? 0 : (d < r - 1000 ? d : r - 1000); }

      // seasons: a test season (0) until S1 opens on Mon 16 Nov 2026 (Taiwan time); S1 runs to the end of
      // Jan 2027, then three months each (Feb–Apr, May–Jul, ...)
      function s1Start() { return 1794758400000; }
      function twNow() { return timestamp.value(request.time.toMillis() + 28800000); }
      function season() {
        return request.time.toMillis() < s1Start() ? 0
          : math.floor(((twNow().year() - 2026) * 12 + twNow().month() - 11) / 3.0) + 1;
      }
      // a record stamped season 1 before S1 opened belongs to the test season
      function seasonOf(d) { return d.get('season', 0) == 1 && d.get('created', 0) < s1Start() ? 0 : d.get('season', 0); }
      function inSeason() { return seasonOf(od()) == season(); }
      // a new season: the rating comes halfway back to 1000 (all the way after the test season), the record
      // starts over, the old one is kept in hist
      function rollOK() {
        let s0 = seasonOf(od());
        return od().pend == '' && s0 < season() && nd().season == season()
          && nd().rating == (s0 < 1 ? 1000 : 1000 + math.floor((od().rating - 1000) / 2.0))
          && nd().games == 0 && nd().wins == 0 && nd().losses == 0 && nd().get('streak', 0) == 0
          && nd().hist.diff(od().get('hist', {})).affectedKeys().hasOnly([string(s0)])
          && nd().hist[string(s0)] == {'r': od().rating, 'w': od().wins, 'l': od().losses};
      }
      // a day in Taiwan time (UTC+8); a phone's clock may be a day off, so either neighbour is accepted
      function today() { return math.floor((request.time.toMillis() + 28800000) / 86400000.0); }
      function aiStartOK() {
        let day = nd().aiDay;
        let n = od().get('aiDay', 0) == day ? od().get('aiN', 0) + 1 : 1;
        let d = floored(od().rating, 25);
        return od().rating < 2100 && nd().pendAt == 0 && nd().pendD == d && nd().rating == od().rating - d && nd().get('pendW', 0) == 25
          && nd().games == od().games + 1 && nd().losses == od().losses + 1
          && day is int && day >= od().get('aiDay', 0) && day >= today() - 1 && day <= today() + 1
          && nd().aiN == n && n <= 5;
      }
      function aiWinOK() {
        return nd().rating == od().rating + od().pendD + od().get('pendW', 25) && nd().get('pendW', 0) == 0 && nd().wins == od().wins + 1 && nd().losses == od().losses - 1
          && nd().games == od().games && nd().pend == '' && nd().pendAt == 0 && nd().pendD == 0;
      }
      function startOK() {
        let r = room(nd().pend);
        let opp = get(/databases/$(database)/documents/players/$(r.seats[other(seatOf(r))])).data;
        let full = lossFor(od().rating, preRating(opp, r));
        let d = floored(od().rating, math.round(full * 0.75));
        return r.cfg.get('ranked', false) == true && inRoom(r) && ('1' in r.seats)
          && nd().pendAt == r.created && nd().pendD == d && nd().get('pendW', 0) == 100 - full
          && nd().rating == od().rating - d
          && nd().games == od().games + 1 && nd().losses == od().losses + 1;
      }
      function winOK() {
        let r = room(od().pend);
        let s = seatOf(r);
        let o = other(s);
        let rep = r.get('rep', {});
        let mine = rep.get(s, {}).get('w', '');
        let theirs = rep.get(o, {}).get('w', '');
        let them = r.setup.get(o, {});
        // a forfeit counts when the opponent left, or has sent no heartbeat for 3 minutes
        let gone = them.get('left', false) == true || them.get('hb', request.time.toMillis()) < request.time.toMillis() - 180000;
        return inRoom(r) && r.created == od().pendAt
          && mine == s && (theirs == s || (theirs == '' && gone))
          && nd().rating == od().rating + od().pendD + od().get('pendW', 100 - od().pendD) + (od().get('streak', 0) >= 3 ? 30 : od().get('streak', 0) * 10)
          && nd().get('pendW', 0) == 0
          && nd().streak == od().get('streak', 0) + 1
          && nd().wins == od().wins + 1 && nd().losses == od().losses - 1
          && nd().games == od().games && nd().pend == '' && nd().pendAt == 0 && nd().pendD == 0;
      }

      allow read: if signedIn();

      allow create: if permanent() && request.auth.uid == uid && shape()
        && nd().rating == 1000 && nd().games == 0 && nd().wins == 0 && nd().losses == 0
        && nd().pend == '' && nd().pendAt == 0 && nd().pendD == 0 && nd().season == season();

      allow update: if permanent() && request.auth.uid == uid && shape() && (
        pchanged().hasOnly(['name'])
        || (od().pend == '' && nd().pend != '' && nd().pend != 'ai' && inSeason() && pchanged().hasOnly(['rating', 'games', 'losses', 'pend', 'pendAt', 'pendD', 'pendW']) && startOK())
        || (od().pend != '' && od().pend != 'ai' && pchanged().hasOnly(['rating', 'wins', 'losses', 'pend', 'pendAt', 'pendD', 'pendW', 'streak']) && winOK())
        || (od().pend == '' && nd().pend == 'ai' && inSeason() && pchanged().hasOnly(['rating', 'games', 'losses', 'pend', 'pendAt', 'pendD', 'pendW', 'aiDay', 'aiN']) && aiStartOK())
        || (pchanged().hasOnly(['rating', 'games', 'wins', 'losses', 'streak', 'season', 'hist']) && rollOK())
        || (od().pend == 'ai' && pchanged().hasOnly(['rating', 'wins', 'losses', 'pend', 'pendAt', 'pendD', 'pendW']) && aiWinOK())
        // dropping a pending game: one against a person was lost, so the streak ends (the computer's leaves it)
        || (pchanged().hasOnly(['pend', 'pendAt', 'pendD', 'pendW', 'streak']) && nd().pend == '' && nd().pendAt == 0 && nd().pendD == 0 && nd().get('pendW', 0) == 0
            && (od().pend == 'ai' ? nd().get('streak', 0) == od().get('streak', 0) : nd().get('streak', 0) == 0))
      );
    }
  }
}
